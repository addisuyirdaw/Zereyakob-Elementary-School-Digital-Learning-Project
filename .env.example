# ─────────────────────────────────────────────────────────────────────────────
# Zereyakob Elementary School — Supabase environment configuration
# Copy to `.env.local` and fill in real values from your Supabase project:
# Project Settings → API → Project URL / anon (public) key.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only "secret"/service-role key. Required to create staff accounts
# from the Dashboard (Staff & Admins tab). Project Settings → API → Secret keys.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SECRET-KEY

# Email of the account that should automatically become Super Admin on first
# sign-up. Optional — otherwise the very first account created gets admin role.
SUPABASE_BOOTSTRAP_ADMIN_EMAIL=you@example.com

# The URL users are sent to after Google/email sign-in.
NEXT_PUBLIC_SITE_URL=http://localhost:3000